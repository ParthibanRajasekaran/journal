# Backend settings. Every variable is read by backend/app/config.py with the JOURNAL_ prefix.
# Copy to backend/.env for local development. Never commit a real .env; secrets stay outside the repository.

JOURNAL_ENVIRONMENT=development            # development | test | production (production hides the API docs)
JOURNAL_LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
JOURNAL_DATABASE_URL=postgresql+asyncpg://127.0.0.1:5433/journal_dev
JOURNAL_PUBLIC_BASE_URL=http://localhost:8000
JOURNAL_PROBLEM_TYPE_BASE=https://journal.example/problems/   # prefix for RFC 9457 problem types
JOURNAL_COOKIE_SECURE=false                # true everywhere except plain-HTTP local development

# Google OAuth (web flow and native ID-token audience). The client id is public; the secret is not.
JOURNAL_GOOGLE_CLIENT_ID=
JOURNAL_GOOGLE_CLIENT_SECRET=

# Signs access tokens. At least 32 random characters.
JOURNAL_JWT_SECRET=
# Encrypts stored per-user provider keys. 32 random bytes, base64.
JOURNAL_KEY_ENCRYPTION_KEY=

# Session lifetimes.
JOURNAL_ACCESS_TOKEN_TTL_SECONDS=900
JOURNAL_REFRESH_TOKEN_TTL_DAYS=30
JOURNAL_OAUTH_STATE_TTL_SECONDS=600

# Models used for estimates with the user's own key. There is no developer-funded provider key.
JOURNAL_ESTIMATE_MODEL_OPENAI=gpt-4o-mini
JOURNAL_ESTIMATE_MODEL_ANTHROPIC=claude-haiku-5-5
JOURNAL_ESTIMATE_MODEL_GEMINI=gemini-2.5-flash

# Abuse limits per signed-in user.
JOURNAL_WRITE_REQUESTS_PER_MINUTE=30
JOURNAL_MEALS_PER_DAY=300

# Optional OTLP/HTTP endpoint for traces and metrics. Unset exports nothing.
# JOURNAL_OTEL_ENDPOINT=http://otel-collector:4318
