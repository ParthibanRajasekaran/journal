{
  "permissions": {
    "allow": [
      "Bash(make gate*)", "Bash(make migrate)", "Bash(make db-setup)",
      "Bash(cd backend && uv run pytest*)", "Bash(cd backend && uv run ruff*)", "Bash(cd backend && uv run mypy*)",
      "Bash(cd web && npm test*)", "Bash(cd web && npm run typecheck*)", "Bash(cd web && npm run build*)",
      "Bash(cd web && npx vitest*)",
      "Bash(git status*)", "Bash(git diff*)", "Bash(git log*)", "Bash(git add*)", "Bash(git commit*)",
      "Bash(scripts/agent/milestone-check.py*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {"hooks": [{"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/agent/session-brief.py", "timeout": 15}]}
    ],
    "PreToolUse": [
      {"matcher": "Edit|Write|NotebookEdit",
       "hooks": [{"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/agent/guard-edit.py", "onFailure": "block", "timeout": 10}]},
      {"matcher": "Bash",
       "hooks": [{"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/agent/guard-bash.py", "onFailure": "block", "timeout": 10}]}
    ],
    "PostToolUse": [
      {"matcher": "Edit|Write",
       "hooks": [{"type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/agent/post-edit.sh", "timeout": 120}]}
    ],
    "Stop": [
      {"hooks": [{"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/agent/stop-gate.py", "timeout": 900}]}
    ]
  }
}
